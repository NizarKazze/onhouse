# Copy to `.env` for local development. Never commit the real `.env`.

# development | production | test
APP_ENV=development

# Long random value, at least 32 chars in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Database: either DATABASE_URL (or POSTGRES_URL), or the PG* values ------
# DATABASE_URL=postgresql://onhouse:password@127.0.0.1:5432/onhouse
# Managed Postgres (Neon / Vercel Postgres, Supabase...) needs ?sslmode=require
DATABASE_URL=
# Direct (non-pooler) URL, used only by `alembic`. Neon: DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=onhouse
PGUSER=onhouse
PGPASSWORD=
# disable | prefer | require | verify-full
PGSSLMODE=prefer
# true on serverless hosts (Vercel), where a connection pool can't be reused.
DB_NULL_POOL=false

# --- HTTP --------------------------------------------------------------------
# The website origin (CORS + Origin checks). https required in production.
FRONTEND_URL=http://localhost:3000
# Comma separated extra origins, e.g. a staging domain.
EXTRA_ALLOWED_ORIGINS=
# Comma separated Host header allow-list. Required in production.
ALLOWED_HOSTS=
# Header with the real client IP when behind a trusted proxy (e.g. x-real-ip
# or x-forwarded-for on Vercel). Leave empty when not behind a proxy you trust.
CLIENT_IP_HEADER=

# --- Sessions & throttling (defaults are sensible) ---------------------------
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_USER_IP=5
LOGIN_MAX_FAILURES_PER_USER=20
LOGIN_MAX_FAILURES_PER_IP=30
RATE_LIMIT_PER_MINUTE=300
ADMIN_WRITE_LIMIT_PER_MINUTE=60

# --- Image uploads (admin "Subir imagen" button) ---------------------------
# local: saved in UPLOAD_DIR and served at /uploads/<file>. Needs a disk that
#        survives deploys (your own server, Render paid disk...).
# s3:    any S3-compatible bucket, e.g. Cloudflare R2 (free tier). REQUIRED on
#        Vercel / Render free, whose disk is wiped on every deploy.
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# Max size per image in MB (Vercel caps request bodies at 4.5 MB; the admin
# shrinks bigger photos in the browser before uploading).
MAX_UPLOAD_MB=4
S3_BUCKET=
# R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public https base the bucket is served from (R2 custom domain or r2.dev URL)
S3_PUBLIC_BASE_URL=
S3_PREFIX=uploads

EVENT_TIMEZONE=Europe/Madrid
LOG_LEVEL=INFO
