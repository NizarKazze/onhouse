# Copy to `.env.local` for local development (or set in Vercel → Settings →
# Environment Variables). Server-side only: never prefix with NEXT_PUBLIC_.

# Backend origin. Public pages read from it at render time, and the browser's
# /api/* calls (the admin panel) are proxied to it. Leave empty to run the
# site on the bundled mock data without a backend.
API_URL=http://127.0.0.1:8000
